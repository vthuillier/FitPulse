# Copy to .env and fill in real values. .env is gitignored - never commit it.

# --- Postgres ---
POSTGRES_DB=fitpulse_db
POSTGRES_USER=fitpulse_user
POSTGRES_PASSWORD=change_me

# --- Backend ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_me
FIRST_ADMIN_EMAIL=admin@fitpulse.com
FIRST_ADMIN_PASSWORD=change_me
CORS_ORIGINS=http://localhost:3000

# --- Frontend (baked in at build time) ---
VITE_API_URL=http://localhost:8000/api/v1
